{
  "name": "@tpsdev-ai/agent",
  "version": "0.8.0",
  "description": "Native TPS Agent Runtime — headless, mail-driven, nono-sandboxed",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./bin": {
      "import": "./dist/bin.js",
      "types": "./dist/bin.d.ts"
    }
  },
  "bin": {
    "tps-agent": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node ../../scripts/test-suite.mjs agent",
    "lint": "biome lint ./src",
    "lint:ci": "biome lint ./src --max-diagnostics=200"
  },
  "keywords": [
    "agents",
    "tps",
    "runtime",
    "mail-driven"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tpsdev-ai/cli.git",
    "directory": "packages/agent"
  },
  "homepage": "https://github.com/tpsdev-ai/cli/tree/main/packages/agent#readme",
  "dependencies": {
    "@noble/ed25519": "3.2.0",
    "canonicalize": "3.0.0",
    "js-tiktoken": "1.0.21",
    "js-yaml": "4.3.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "author": "tpsdev-ai",
  "publishConfig": {
    "access": "public"
  }
}
