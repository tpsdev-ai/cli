{
  "name": "@tpsdev-ai/cli",
  "version": "0.5.5",
  "description": "TPS Report CLI — because every agent needs the proper paperwork.",
  "type": "module",
  "bin": {
    "tps": "./bin/tps.cjs"
  },
  "main": "./dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js",
    "./lib/signEnvelope": "./dist/src/lib/signEnvelope.js",
    "./utils/flair-client": "./dist/src/utils/flair-client.js"
  },
  "optionalDependencies": {
    "@tpsdev-ai/cli-darwin-arm64": "0.5.4",
    "@tpsdev-ai/cli-darwin-x64": "0.5.4",
    "@tpsdev-ai/cli-linux-arm64": "0.5.4",
    "@tpsdev-ai/cli-linux-x64": "0.5.4"
  },
  "scripts": {
    "build": "tsc",
    "build:binary": "bun run build:binary:darwin-arm64 && bun run build:binary:darwin-x64 && bun run build:binary:linux-arm64 && bun run build:binary:linux-x64",
    "build:binary:darwin-arm64": "bun run scripts/build-portable.ts bun-darwin-arm64",
    "build:binary:darwin-x64": "bun run scripts/build-portable.ts bun-darwin-x64",
    "build:binary:linux-arm64": "bun run scripts/build-portable.ts bun-linux-arm64",
    "build:binary:linux-x64": "bun run scripts/build-portable.ts bun-linux-x64",
    "dev": "tsc --watch",
    "start": "node dist/bin/tps.js",
    "tps": "node dist/bin/tps.js",
    "lint": "biome lint ./src ./bin && node ../../scripts/lint-flair-keypath.mjs src",
    "lint:ci": "biome lint ./src ./bin --max-diagnostics=200 && node ../../scripts/lint-flair-keypath.mjs src",
    "pretest": "tsc",
    "test": "bun test",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "keywords": [
    "cli",
    "agents",
    "openclaw",
    "tps"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tpsdev-ai/cli.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/tpsdev-ai/cli#readme",
  "dependencies": {
    "@noble/curves": "^2.0.1",
    "@noble/ed25519": "^3.0.0",
    "@noble/hashes": "^2.0.1",
    "@types/ws": "^8.18.1",
    "handlebars": "^4.7.8",
    "ink": "^5.2.0",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^4.1.0",
    "meow": "^13.2.0",
    "msgpackr": "^1.11.8",
    "noise-handshake": "^4.2.0",
    "react": "^18.3.1",
    "safe-regex": "^2.1.1",
    "snooplogg": "^6.1.1",
    "ws": "^8.19.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/safe-regex": "^1.1.6",
    "blake2b": "^2.1.4",
    "chacha20-universal": "^1.0.4",
    "fast-check": "^4.5.3",
    "nanoassert": "^3.1.0",
    "sha256-universal": "^1.2.1",
    "sha512-universal": "^1.2.1",
    "siphash24": "^1.3.1",
    "sodium-javascript": "^0.8.0",
    "typescript": "^5.7.0",
    "xsalsa20": "^1.2.0",
    "@tpsdev-ai/agent": "workspace:*"
  },
  "files": [
    "bin",
    "scripts",
    "nono-profiles",
    "personas",
    "reports",
    "README.md"
  ],
  "author": "tpsdev-ai",
  "publishConfig": {
    "access": "public"
  }
}
