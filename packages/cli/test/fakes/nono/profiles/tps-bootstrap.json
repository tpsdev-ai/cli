{
  "$schema": "https://nono.sh/schemas/nono-profile.schema.json",
  "extends": "tps-base",
  "meta": {
    "name": "tps-bootstrap",
    "version": "2.0.0",
    "description": "Bootstrap protocol checks and health verification."
  },
  "workdir": {
    "access": "readwrite"
  },
  "filesystem": {
    "allow": ["/workspace", "/tmp"]
  },
  "network": {
    "block": false,
    "allow_domain": ["127.0.0.1", "localhost"]
  }
}
