#!/usr/bin/env bash
# =============================================================================
# FAKE nono binary — for use in TPS test environments ONLY
#
# Simulates the nono CLI interface without kernel enforcement.
# Real nono: https://nono.sh
#
# Usage:
#   nono run [--profile <name|path>] [--workdir <path>] -- <command> [args...]
#   nono profile validate [--strict] <path>
#   nono --version
#   nono --help
#
# Environment variables (for test control):
#   NONO_FAKE_LOG           Path to log file (default: /tmp/nono-fake.log)
#   NONO_FAKE_VERSION       Version string to report (default: 0.74.0-fake)
#   NONO_FAKE_VALIDATE_FAIL If set, `profile validate` exits non-zero
#   NONO_FAKE_CANARY        If set, checks if this path is accessible.
#
# The fake logs every invocation to NONO_FAKE_LOG so tests can inspect calls.
#
# The reported version is >= the TPS floor (0.70.0) on purpose: TPS refuses to
# launch below the floor, and the floor is exercised by overriding
# NONO_FAKE_VERSION in the tests instead of by shipping an outdated fake.
# =============================================================================

set -eo pipefail

FAKE_VERSION="${NONO_FAKE_VERSION:-0.74.0-fake}"
LOG_FILE="${NONO_FAKE_LOG:-/tmp/nono-fake.log}"

# Resolve this script's "profiles" dir relative to binary location
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BUILTIN_PROFILE_DIR="${SCRIPT_DIR}/../profiles"
# Resolve if it exists, else keep relative (cd would fail with set -e)
if [[ -d "${BUILTIN_PROFILE_DIR}" ]]; then
  BUILTIN_PROFILE_DIR="$(cd "${BUILTIN_PROFILE_DIR}" && pwd)"
fi

log() {
  echo "[nono-fake $(date -u +%Y-%m-%dT%H:%M:%SZ)] $*" >> "$LOG_FILE"
}

die() {
  echo "nono: error: $*" >&2
  log "ERROR: $*"
  exit 1
}

# Resolve a profile argument to a file:
#   - an absolute or ./-relative path is used as given (TPS passes full paths)
#   - a bare name is looked up as <name>.json in the user dir, then builtin dir
resolve_profile() {
  local want="$1"
  if [[ "$want" == /* || "$want" == ./* ]]; then
    [[ -f "$want" ]] && { echo "$want"; return 0; }
    return 1
  fi
  local dir
  for dir in "${HOME:-}/.config/nono/profiles" "$BUILTIN_PROFILE_DIR"; do
    if [[ -f "$dir/${want}.json" ]]; then
      echo "$dir/${want}.json"
      return 0
    fi
  done
  return 1
}

# -----------------------------------------------------------------------
# Subcommand: --version
# -----------------------------------------------------------------------
if [[ "${1:-}" == "--version" ]] || [[ "${1:-}" == "-V" ]]; then
  echo "nono $FAKE_VERSION (fake — kernel enforcement disabled)"
  exit 0
fi

# -----------------------------------------------------------------------
# Subcommand: --help
# -----------------------------------------------------------------------
if [[ "${1:-}" == "--help" ]] || [[ "${1:-}" == "-h" ]] || [[ -z "${1:-}" ]]; then
  cat <<EOF
nono $FAKE_VERSION (fake — kernel enforcement disabled)

USAGE:
  nono run [OPTIONS] -- <command> [args...]
  nono profile validate [--strict] <path>

OPTIONS:
  --profile <name|path>  Apply profile (~/.config/nono/profiles/<name>.json)
  --workdir <path>       Override working directory for sandbox
  --allow <path>         Grant read+write access to path (adds to profile)
  --read <path>          Grant read-only access to path (adds to profile)
  --allow-cwd            Skip CWD sharing prompt
  -V, --version          Print version
  -h, --help             Print help

ENVIRONMENT (fake-specific):
  NONO_FAKE_LOG           Log file path (default: /tmp/nono-fake.log)
  NONO_FAKE_VERSION       Reported version (default: 0.74.0-fake)
  NONO_FAKE_VALIDATE_FAIL Make \`profile validate\` fail
  NONO_FAKE_CANARY        Canary file path for enforcement verification

NOTE: This is a test fake. No kernel enforcement is applied.
      Install real nono from https://nono.sh for production use.
EOF
  exit 0
fi

# -----------------------------------------------------------------------
# Subcommand: profile validate [--strict] <path>
# -----------------------------------------------------------------------
if [[ "${1:-}" == "profile" ]]; then
  shift
  [[ "${1:-}" == "validate" ]] || die "unknown profile subcommand: '${1:-}'. Expected 'validate'"
  shift
  [[ "${1:-}" == "--strict" ]] && shift
  VALIDATE_PATH="${1:-}"
  [[ -n "$VALIDATE_PATH" ]] || die "profile validate requires a path"
  if [[ -n "${NONO_FAKE_VALIDATE_FAIL:-}" ]]; then
    log "PROFILE_INVALID path=$VALIDATE_PATH"
    echo "nono: profile invalid: $VALIDATE_PATH (forced by NONO_FAKE_VALIDATE_FAIL)" >&2
    exit 1
  fi
  if [[ ! -f "$VALIDATE_PATH" ]]; then
    log "PROFILE_INVALID path=$VALIDATE_PATH (missing)"
    echo "nono: profile invalid: $VALIDATE_PATH: no such file" >&2
    exit 1
  fi
  log "PROFILE_VALID path=$VALIDATE_PATH"
  echo "Result: valid"
  exit 0
fi

# -----------------------------------------------------------------------
# Subcommand: run
# -----------------------------------------------------------------------
if [[ "${1:-}" != "run" ]]; then
  die "unknown subcommand: '${1:-}'. Expected 'run' or 'profile'"
fi
shift

# --- Parse arguments ---
PROFILE_NAME=""
WORKDIR_OVERRIDE=""
EXTRA_ALLOW=()
EXTRA_READ=()
SKIP_CWD_PROMPT=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile)
      PROFILE_NAME="${2:?--profile requires a value}"
      shift 2
      ;;
    --workdir)
      WORKDIR_OVERRIDE="${2:?--workdir requires a value}"
      shift 2
      ;;
    --allow)
      EXTRA_ALLOW+=("${2:?--allow requires a path}")
      shift 2
      ;;
    --read)
      EXTRA_READ+=("${2:?--read requires a path}")
      shift 2
      ;;
    --allow-cwd)
      SKIP_CWD_PROMPT=true
      shift
      ;;
    --)
      shift
      break
      ;;
    *)
      die "unknown flag: '$1'"
      ;;
  esac
done

if [[ $# -eq 0 ]]; then
  die "no command specified after --"
fi

COMMAND=("$@")

# --- Resolve profile ---
if [[ -n "$PROFILE_NAME" ]]; then
  if ! PROFILE_FILE="$(resolve_profile "$PROFILE_NAME")"; then
    log "PROFILE_NOT_FOUND profile=$PROFILE_NAME"
    die "profile not found: '$PROFILE_NAME'. Searched: ${HOME:-}/.config/nono/profiles/, $BUILTIN_PROFILE_DIR"
  fi
  log "PROFILE_LOADED profile=$PROFILE_NAME file=$PROFILE_FILE"
else
  log "NO_PROFILE command=${COMMAND[*]}"
fi

for p in "${EXTRA_ALLOW[@]+"${EXTRA_ALLOW[@]}"}"; do
  log "ALLOW path=$p"
done
for p in "${EXTRA_READ[@]+"${EXTRA_READ[@]}"}"; do
  log "READ path=$p"
done

# --- Canary check (for enforcement verification against real nono) ---
if [[ -n "${NONO_FAKE_CANARY:-}" ]]; then
  if [[ -r "$NONO_FAKE_CANARY" ]]; then
    log "CANARY_ACCESSIBLE path=$NONO_FAKE_CANARY (WARN: real nono would block this)"
    echo "nono-fake: WARNING: canary file is accessible (no kernel enforcement in fake mode)" >&2
  else
    log "CANARY_INACCESSIBLE path=$NONO_FAKE_CANARY"
  fi
fi

# --- Log invocation ---
log "INVOKE profile=${PROFILE_NAME:-none} workdir=${WORKDIR_OVERRIDE:-cwd} command=${COMMAND[*]}"

# --- Execute command ---
if [[ -n "$WORKDIR_OVERRIDE" ]]; then
  cd "$WORKDIR_OVERRIDE"
fi

exec "${COMMAND[@]}"
