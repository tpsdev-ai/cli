{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>tpsdev-ai/flair//.github/renovate-preset"
  ],
  "packageRules": [
    {
      "description": "test/renovate-tpsdev-deps.test.ts rejects nonrelease @tpsdev-ai/* dependencies in regular, non-symlinked package.json files outside node_modules and .git.",
      "matchPackageNames": [
        "@tpsdev-ai/**"
      ],
      "enabled": false
    },
    {
      "matchDepTypes": [
        "engines"
      ],
      "enabled": false
    },
    {
      "matchDepTypes": [
        "peerDependencies"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "npm",
        "bun"
      ],
      "matchPackageNames": [
        "bun",
        "node"
      ],
      "enabled": false
    },
    {
      "description": "A setup action's uses-with dependency is named bun or node while its package is the action (e.g. actions/node-versions), so match it by dep name.",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "uses-with"
      ],
      "matchDepNames": [
        "bun",
        "node"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "openclaw"
      ],
      "enabled": false
    },
    {
      "matchFileNames": [
        "packages/**/package.json"
      ],
      "matchDepTypes": [
        "dependencies"
      ],
      "rangeStrategy": "widen"
    }
  ]
}
