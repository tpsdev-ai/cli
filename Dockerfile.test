# The integration image runs the Bun this repository pins, not a hard-coded
# floating tag (cli#578): cli#575's TOML cases passed under the pin and failed
# under the newer floating image. BUN_VERSION is REQUIRED — it deliberately has
# no default, so an omitted arg expands the FROM reference to the invalid
# `oven/bun:-slim` and the build fails loudly instead of following a moving tag.
# docker-compose.yml forwards it and the Docker Integration workflow derives it
# from package.json's packageManager (scripts/docker-bun-version.sh);
# scripts/check-bun-pin.sh fails when those disagree.
ARG BUN_VERSION
FROM oven/bun:${BUN_VERSION}-slim

WORKDIR /app

# nodejs: the SHIPPED CLI is a node script (`#!/usr/bin/env node`) and the
# attested-launch positive must run it the way a unit does. bun cannot stand in:
# bun inside a nono sandbox sees an EMPTY environment (measured — see
# packages/cli/test/launch-attestation-real-nono.test.ts), so the launcher's
# socket locator never reaches a bun child.
RUN apt-get update && apt-get install -y git jq procps nodejs && rm -rf /var/lib/apt/lists/*

# Create fake home directory with OpenClaw structure
RUN mkdir -p /home/tps/.openclaw/workspace-test \
    && mkdir -p /home/tps/.openclaw/agents \
    && mkdir -p /workspace

# A NON-ROOT user for the attested-launch lane (cli#350 round 4e: the Linux run
# of the positive happens as a non-root Docker lane user). HOME stays /home/tps.
RUN useradd -m -s /bin/bash -u 1001 tps 2>/dev/null || useradd -m -s /bin/bash tps; \
    chown -R tps:tps /home/tps

ENV HOME=/home/tps

# Mock openclaw binary — returns canned JSON for common commands
RUN printf '#!/bin/sh\n\
case "$1" in\n\
  status) echo '"'"'{"status":"running","version":"0.1.0"}'"'"';;\n\
  "config") echo '"'"'{"agents":{"list":[]}}'"'"';;\n\
  *) echo "mock openclaw: $@";;\n\
esac\n' > /usr/local/bin/openclaw \
    && chmod +x /usr/local/bin/openclaw

# Copy root workspace files
COPY package.json bun.lock* tsconfig*.json ./

# Copy package manifests first for layer caching
COPY packages/cli/package.json packages/cli/tsconfig.json ./packages/cli/
COPY packages/cli/scripts/ ./packages/cli/scripts/
COPY packages/agent/package.json packages/agent/tsconfig.json ./packages/agent/

RUN bun install --frozen-lockfile 2>/dev/null || bun install

# Copy all source
COPY . .

# Make test fakes executable
RUN chmod +x test/fakes/nono/bin/nono 2>/dev/null || true
RUN chmod +x packages/cli/test/fakes/nono/bin/nono 2>/dev/null || true

# Build TypeScript (monorepo workspaces)
RUN bun run build

CMD ["bun", "run", "test"]
